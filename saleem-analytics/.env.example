# SALEEM Analytics Center Environment Configuration
# Copy this file to .env or configure directly in Vercel Project Settings

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Public key for client-side queries protected by RLS)
SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Optional: Port for local node server
PORT=3001
