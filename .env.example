# =============================================================
# SALEEM Production Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================

# Server
PORT=3000
NODE_ENV=production
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
SESSION_SECRET=your-secure-random-session-secret

# AI Provider (OpenRouter - supports multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key
AI_MODEL=meta-llama/llama-3.3-70b-instruct
AI_FALLBACK_MODEL=google/gemma-2-9b-it

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD

# Google Maps (optional - app works without it)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Database
DATABASE_PATH=./data/saleem.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=30

# Admin (first admin user created on startup)
ADMIN_EMAIL=admin@saleem.app
ADMIN_PASSWORD=change-this-secure-password

# CORS
CORS_ORIGIN=http://localhost:3000
