{
  "version": 2,
  "name": "saleem",
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/dialect_lessons_600.json",
          "data/culture_lessons_100.json",
          "data/phrases_45.json"
        ]
      }
    },
    {
      "src": "app.html",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "landing.css",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/dialect_lessons_600.json",
      "use": "@vercel/static"
    },
    {
      "src": "data/culture_lessons_100.json",
      "use": "@vercel/static"
    },
    {
      "src": "data/phrases_45.json",
      "use": "@vercel/static"
    },
    {
      "src": "downloads/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/app",
      "dest": "/app.html"
    },
    {
      "src": "/downloads/(.*)",
      "dest": "/downloads/$1",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
